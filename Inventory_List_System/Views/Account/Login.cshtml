@{
    ViewData["Title"] = "Login";
}

<div class="auth-card">
    <h2 class="page-title mb-1">Welcome Back</h2>
    <p class="section-subtitle mb-3">Log in to manage your Bobcats inventory.</p>

    <form method="post">
        <div class="mb-3">
            <label class="form-label">Username</label>
            <input type="text" name="username" class="form-control" value="@ViewBag.Username" required minlength="3" />
        </div>

        <div class="mb-3">
            <label class="form-label">Password</label>
            <input type="password" name="password" class="form-control" required minlength="6" />
        </div>

        <button type="submit" class="btn bobcats-btn-primary w-100">Login</button>
    </form>
</div>

@section Scripts {
    @if (ViewBag.Error != null)
    {
        <script>
            Swal.fire({
                icon: 'error',
                title: 'Login Failed',
                text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Error))
            });
        </script>
    }
}
